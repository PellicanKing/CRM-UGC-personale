# Copy to .env.local and fill in. Never commit .env.local.
ANTHROPIC_API_KEY=
# Optional: override the SQLite file location
# DATABASE_PATH=data/crm.db

# Email provider: "proton" (real sending) or "console" (dry run, logs only)
EMAIL_PROVIDER=console

# Sender shown to recipients
MAIL_FROM_ADDRESS=tu@tuodominio.it
MAIL_FROM_NAME=Il tuo nome

# --- Proton Mail Bridge (default) ---
# Credentials are the ones shown in the Bridge app (NOT your Proton password).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=tu@tuodominio.it
SMTP_PASS=
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=tu@tuodominio.it
IMAP_PASS=

# --- Alternative: Proton SMTP submission (custom domain, sending only, no Bridge) ---
# SMTP_HOST=smtp.protonmail.ch
# SMTP_PORT=587
# SMTP_USER=tu@tuodominio.it
# SMTP_PASS=<SMTP token from Proton settings>
# Leave IMAP_* empty: reply detection then needs Bridge.
