# ============================================================
#  CONFIGURAZIONE DEL CRM
#  Scrivi i tuoi dati DOPO il simbolo "=" senza spazi e senza virgolette.
#  Le righe che iniziano con # sono solo spiegazioni.
#  Dopo ogni modifica: salva, chiudi la finestra del CRM e riavvialo.
# ============================================================

# --- 1. Intelligenza artificiale (Claude) ---
# Incolla qui la chiave che inizia con sk-ant-
ANTHROPIC_API_KEY=

# --- 2. Modalita' di invio ---
# console = modalita' di prova, NON invia email vere (lascia cosi' all'inizio)
# proton  = invia davvero con Proton Mail (serve Proton Mail Bridge aperto)
EMAIL_PROVIDER=console

# --- 3. Il tuo indirizzo email (quello che vedranno i destinatari) ---
MAIL_FROM_ADDRESS=tu@tuodominio.it
MAIL_FROM_NAME=Il tuo nome

# --- 4. Proton Mail Bridge ---
# Copia "Username" e "Password" dalla finestra del Bridge.
# ATTENZIONE: e' la password del Bridge, NON la password del tuo account Proton.
# Non modificare HOST e PORT.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=tu@tuodominio.it
SMTP_PASS=
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=tu@tuodominio.it
IMAP_PASS=

# --- Facoltativo ---
# DATABASE_PATH=data/crm.db
# SCHEDULER_DISABLED=1   (spegne gli invii automatici)
